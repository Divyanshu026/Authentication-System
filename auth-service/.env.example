# Database Configuration
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=auth_db
DATABASE_URL=postgresql://auth_user:change_me_local_only@postgres:5432/auth_db
REDIS_URL=redis://redis:6379

# Server Configuration
NODE_ENV=production
PORT=3000
TRUST_PROXY=false
FRONTEND_URL=http://localhost:3000

# Security
JWT_SECRET=replace_this_with_a_secure_random_string_in_production

SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your_smtp_email@domain.com
SMTP_PASS=your_secure_smtp_password
EMAIL_FROM=noreply@yourdomain.com